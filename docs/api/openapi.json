  "components": {
    "schemas": {
      "DatasetMeta": {
        "properties": {
          "dataset_version_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Dataset Version Ids"
          },
          "reference_date": {
            "type": "string",
            "title": "Reference Date",
            "default": "2025-12-15"
          },
          "model_run_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Run Id"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "geographic_warning": {
            "type": "string",
            "title": "Geographic Warning",
            "default": ""
          },
          "filters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Filters"
          }
        },
        "type": "object",
        "title": "DatasetMeta",
        "description": "Versions, reference date and filters that identify a dataset snapshot."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
