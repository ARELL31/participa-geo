# PARTICIPA-GEO — environment template
#
# Copy to `.env` and set real values before starting the stack. The values here
# are placeholders, not secrets. Never commit `.env`; it is ignored by Git.
# All host bindings are loopback-only; the database and GeoServer publish no
# host ports.

# --- PostgreSQL superuser (bootstraps the cluster; used only by db-init.sh) ---
POSTGRES_USER=participa_admin
POSTGRES_PASSWORD=change-me-postgres

# --- Database roles created by db-init.sh (least privilege) ---
# migrator owns schema and migrations; the API never uses migrator.
DB_MIGRATOR_USER=migrator
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_WRITER_USER=writer
DB_WRITER_PASSWORD=change-me-writer
DB_API_USER=api
DB_API_PASSWORD=change-me-api
DB_GIS_READER_USER=gis_reader
DB_GIS_READER_PASSWORD=change-me-gis-reader

# --- Shared database settings ---
DB_NAME=participa_geo
DB_HOST=db
DB_PORT=5432

# --- GeoServer admin (obligatory; reachable only on the internal network) ---
GIS_ADMIN_USER=admin
GIS_ADMIN_PASSWORD=change-me-gis-admin

# --- API / application ---
APP_ENV=development
LOG_LEVEL=INFO
JSON_MAX_BYTES=32768
SKIP_DEMO_DATA=true

# --- Local web proxy (loopback only) ---
# Use 8081 for an isolated clean-room stack (docker compose -p ...).
WEB_PORT=8080
